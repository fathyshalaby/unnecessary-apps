# Keep the real file outside this repository at:
# ~/.private_keys/appstoreconnect.env
# Never commit the real .p8 key or this file with populated values.

ASC_KEY_ID=REPLACE_WITH_KEY_ID
ASC_ISSUER_ID=REPLACE_WITH_ISSUER_ID
ASC_KEY_PATH=/absolute/path/to/AuthKey_REPLACE_WITH_KEY_ID.p8

# The release helper uses this existing per-app external group by default.
# Override only if the App Store Connect group is intentionally renamed.
# ASC_BETA_GROUP=Unnecessary Apps Friends
# Beta App Review submission is deliberately opt-in; Apple may require it for
# the first external build of each app.
# ASC_SUBMIT_BETA_REVIEW=false

# Required before submitting a first external build for beta review. Keep the
# real contact values outside this repository and use an international phone
# format beginning with +. ASC_REVIEW_CONTACT_EMAIL falls back to
# ASC_FEEDBACK_EMAIL when both are set at runtime.
# ASC_FEEDBACK_EMAIL=you@example.com
# ASC_REVIEW_CONTACT_FIRST_NAME=YourFirstName
# ASC_REVIEW_CONTACT_LAST_NAME=YourLastName
# ASC_REVIEW_CONTACT_PHONE=+43 1 234567
# ASC_REVIEW_CONTACT_EMAIL=you@example.com
